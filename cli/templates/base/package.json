{
  "name": "expo-nativewind-typescript-boilerplate",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "bunx expo start -c",
    "dev": "bunx expo start --dev-client -c",
    "android": "bun expo run:android",
    "android:prebuild": "npx expo prebuild && bun expo run:android",
    "ios": "bun expo run:ios",
    "ios:prebuild": "npx expo prebuild && bun expo run:ios",
    "web": "bun run expo start --web",
    "test": "bun run jest --watchAll",
    "format": "bun run prettier --write .",
    "format:check": "bun run prettier --check .",
    "clean": "rm -rf node_modules .expo ios android",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": true
      }
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@tanstack/query-sync-storage-persister": "5.108.4",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-query-persist-client": "5.108.4",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-unistyles": "3.9.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@dev-plugins/react-native-mmkv": "0.4.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.5.1",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.3.0",
    "tailwindcss": "3.4.19",
    "typescript": "~6.0.3"
  },
  "private": true
}
